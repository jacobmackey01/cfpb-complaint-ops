# Store populated values in the deployment platform's encrypted environment.
CFPB_API_URL=https://www.consumerfinance.gov/data-research/consumer-complaints/search/api/v1/
CFPB_SNAPSHOT_LIMIT=100000
DATA_DIR=/app/data
DUCKDB_PATH=/app/data/local/cfpb_triage.duckdb
ARTIFACT_DIR=/app/artifacts/runtime
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=https://replace-with-your-frontend.example
# Blank means same-origin /api/v1; otherwise use the full API origin.
VITE_API_BASE_URL=
OPENAI_API_KEY=
PUBLIC_DEMO_MODE=false
CFPB_LIVE_READ_MODE=true
CFPB_ALLOW_DEMO_FALLBACK=false
LLM_SUMMARY_ENABLED=false
LLM_MODEL=gpt-5.6-luna
LLM_PRICE_TABLE_VERSION=2026-08-21
LLM_INPUT_USD_PER_MILLION_TOKENS=0.20
LLM_OUTPUT_USD_PER_MILLION_TOKENS=1.20
LOG_LEVEL=INFO
